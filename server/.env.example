# Server environment variables
# Rename this file to .env and fill in your own values.

# Database connection string used by Prisma
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# Clerk secret key used by the backend to verify requests
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Clerk publishable key (required by @clerk/express middleware)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional: port to run the server on
PORT=3000
