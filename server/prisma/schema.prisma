generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      String @id @default(cuid())
  clerkId String @unique
  name    String
  email   String @unique

  role Role?

  roleTitle        String?
  bio              String?
  hourlyRate       Int?
  languages        Json?
  skills           Json?
  documents        Json?
  country          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  onboardingComplete Boolean @default(false)

  jobs            Job[]          @relation("HirerJobs")
  engagements     Engagement[]   @relation("WorkerEngagements")
  dismissals      JobDismissal[]
  reviewsGiven    Review[]       @relation("ReviewAuthor")
  reviewsReceived Review[]       @relation("ReviewSubject")

  conversationsAsHirer Conversation[] @relation("HirerConversation")
  conversationsAsWorker Conversation[] @relation("WorkerConversation")
  sentMessages         Message[]      @relation("MessageSender")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id          String @id @default(cuid())
  title       String
  description String
  location    String
  budget      Decimal
  budgetType  BudgetType
  minWage     Decimal?
  experience  Int
  category    JobCategory
  startDate   DateTime
  endDate     DateTime?
  status      JobStatus @default(OPEN)
  positions   Int     @default(1)
  filledCount Int     @default(0)

  hirerId String
  hirer   User   @relation("HirerJobs", fields: [hirerId], references: [id], onDelete: Cascade)

  engagements  Engagement[]
  dismissals    JobDismissal[]
  reviews       Review[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hirerId])
  @@index([status])
  @@index([category])
  @@index([location])
}

model Engagement {
  id String @id @default(cuid())

  workerId String
  worker   User   @relation("WorkerEngagements", fields: [workerId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status    EngagementStatus @default(ACTIVE)

  cancellationReason String?

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([jobId])
  @@index([status])
}

model JobDismissal {
  id String @id @default(cuid())

  workerId String
  worker   User   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workerId, jobId])
  @@index([workerId])
  @@index([jobId])
}

model Review {
  id      String @id @default(cuid())
  rating  Int
  comment String?

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  subjectId String
  subject   User   @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([engagementId, authorId, subjectId])
  @@index([jobId])
  @@index([authorId])
  @@index([subjectId])
}

model Conversation {
  id        String   @id @default(cuid())
  jobId     String
  hirerId   String
  workerId  String

  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  hirer   User @relation("HirerConversation", fields: [hirerId], references: [id], onDelete: Cascade)
  worker  User @relation("WorkerConversation", fields: [workerId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())

  @@unique([jobId, workerId])
  @@index([hirerId])
  @@index([workerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
}

enum Role {
  HIRER
  WORKER
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
}

enum EngagementStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BudgetType {
  HOURLY
  DAILY
  FIXED
}

enum JobCategory {
  CARPENTER
  ELECTRICIAN
  PLUMBER
  PAINTER
  CLEANER
  GARDENER
  MASON
  DRIVER
  COOK
  SECURITY
  OTHER
}
